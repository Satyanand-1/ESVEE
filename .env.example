# Copy to .env.local for local development, or set these in the hosting dashboard
# (Render: Environment tab). They are read on the server only and never sent to the browser.

# Mailbox that receives contact and resume submissions (defaults to us@esveetech.com).
CONTACT_TO_EMAIL=us@esveetech.com
# Address the website sends from. Must be allowed by the provider below.
CONTACT_FROM_EMAIL=website@esveetech.com

# Option A: Resend (https://resend.com). Sends over HTTPS, which works on hosts that block SMTP ports.
RESEND_API_KEY=

# Option B: SMTP from your mail provider. Used when RESEND_API_KEY is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
